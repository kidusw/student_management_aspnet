@model ListRegDto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Registrations";
    // var courses = ViewData["Courses"] as List<SelectListItem> ?? new List<SelectListItem>();
}

<h1>Registrations</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form asp-action="Index" method="get" class="form-inline mb-3">
    <input type="text" asp-for="searchString" placeholder="Search by student name..." class="form-control" />
    <select asp-for="SearchCourseId" asp-items="Model.CourseList" class="form-control">
        <option value="">Select </option>
    </select>
    <input type="submit" value="Search" class="btn btn-default" />
    <a asp-action="Index" class="btn btn-link">Clear</a>
</form>
<table class="table">
    <thead>
        <tr>
      
            <th>
              Id
            </th>
            <th>
               Name
            </th>
            <th>
                CourseName
            </th>
            <th>
               Grade
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.registrations) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Id)
            </td>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Course)
            </td>
            <td>
                @Html.DisplayFor(model => item.Grade)
            </td>
           
         
         
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
