@model StudentManagement.Models.Registration

@{
    ViewData["Title"] = "Registration Details";
}

<div class="detail-card">
    <div class="detail-card-header">
        <div>
            <h2>@Model?.Student.FirstName @Model?.Student.LastName</h2>
            <span class="detail-subtitle">@Model?.Course.CourseCode &middot; @Model?.Course.CourseName</span>
        </div>
        <span class="status-badge status-@Model?.Status.ToString().ToLowerInvariant()">@Model?.Status</span>
    </div>

    <dl class="detail-list">
        <div class="detail-row">
            <dt>Student</dt>
            <dd><a asp-controller="Student" asp-action="Details" asp-route-id="@Model?.StudentId">@Model?.Student.FirstName @Model?.Student.LastName</a></dd>
        </div>
        <div class="detail-row">
            <dt>Course</dt>
            <dd><a asp-controller="Course" asp-action="Details" asp-route-id="@Model?.CourseId">@Model?.Course.CourseCode &ndash; @Model?.Course.CourseName</a></dd>
        </div>
        <div class="detail-row">
            <dt>Registration Date</dt>
            <dd>@Model?.RegistrationDate.ToString("MMMM d, yyyy")</dd>
        </div>
        <div class="detail-row">
            <dt>Grade</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model?.Grade) ? "Not graded yet" : Model.Grade)</dd>
        </div>
    </dl>
</div>

<div class="detail-actions">
    <a asp-action="Edit" asp-route-id="@Model?.RegistrationId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-link">Back to List</a>
</div>
