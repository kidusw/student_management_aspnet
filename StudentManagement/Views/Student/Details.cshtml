                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No cancelled courses.</p>
    }
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.StudentId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
