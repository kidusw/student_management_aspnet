@model StudentManagement.Models.Student

@{
    ViewData["Title"] = "Details";
    var activeRegistrations = Model!.Registrations
        .Where(r => r.Status == RegistrationStatus.Active)
        .OrderByDescending(r => r.RegistrationDate)
        .ToList();
    var completedRegistrations = Model.Registrations
        .Where(r => r.Status == RegistrationStatus.Completed)
        .OrderByDescending(r => r.RegistrationDate)
        .ToList();
    var droppedRegistrations = Model.Registrations
        .Where(r => r.Status == RegistrationStatus.Dropped)
        .OrderByDescending(r => r.RegistrationDate)
        .ToList();
    var cancelledRegistrations = Model.Registrations
        .Where(r => r.Status == RegistrationStatus.Cancelled)
        .OrderByDescending(r => r.RegistrationDate)
        .ToList();
}

<h1>Details</h1>

<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StudentId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StudentId)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LastName)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Age)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Age)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateOfBirth)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateOfBirth)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MobileNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MobileNumber)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Department
        </dt>
        <dd class = "col-sm-10">
            @Model?.Department.Name
        </dd>
    </dl>
</div>

<div class="mt-4">
    <h4>Active Courses</h4>
    @if (activeRegistrations.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Registration Date</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registration in activeRegistrations)
                {
                    <tr>
                        <td>
                            <a asp-controller="Course" asp-action="Details" asp-route-id="@registration.CourseId">
                                @registration.Course.CourseCode &ndash; @registration.Course.CourseName
                            </a>
                        </td>
                        <td>@registration.RegistrationDate.ToString("MMMM d, yyyy")</td>
                        <td>@(string.IsNullOrWhiteSpace(registration.Grade) ? "—" : registration.Grade)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No active course registrations.</p>
    }
</div>

<div class="mt-4">
    <h4>Completed Courses</h4>
    @if (completedRegistrations.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Registration Date</th>
                    <th>Grade</th>
                </tr>
