                </tr>
            </thead>
            <tbody>
                @foreach (var registration in droppedRegistrations)
                {
                    <tr>
                        <td>
                            <a asp-controller="Course" asp-action="Details" asp-route-id="@registration.CourseId">
                                @registration.Course.CourseCode &ndash; @registration.Course.CourseName
                            </a>
                        </td>
                        <td>@registration.RegistrationDate.ToString("MMMM d, yyyy")</td>
                        <td>@(string.IsNullOrWhiteSpace(registration.Grade) ? "—" : registration.Grade)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No dropped courses.</p>
    }
</div>

