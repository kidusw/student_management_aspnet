@model IEnumerable<StudentManagement.Models.UserListItemViewModel>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<p>
    <a asp-action="Create" class="btn-create">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14" /><path d="M5 12h14" /></svg>
        <span>Create New</span>
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Display Name</th>
            <th>Username / Email</th>
            <th>Role</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.DisplayName</td>
            <td>@item.UserName</td>
            <td>@item.Role</td>
            <td>@(item.IsActive ? "Active" : "Deactivated")</td>
            <td>
                <div class="action-links">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-link action-link-edit" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .622.622l4.353-1.32a2 2 0 0 0 .83-.497Z" /></svg>
                        <span>Edit</span>
                    </a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
